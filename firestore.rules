rules_version = '2';

/* ============================================================
   Firestore rules for the Vijayshree Healthcare website.

   Paste these into:
     Firebase console → Firestore Database → Rules → Publish

   The website is public, so anyone may READ the content and the
   pictures. Only a signed-in admin account may CHANGE anything.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* The single document holding all website text. */
    match /site/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* One document per picture (data-URL inside the document —
       Firebase Storage is never used, so nothing is billed). */
    match /media/{mediaId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* Nothing else is reachable. */
    match /{document=**} {
      allow read, write: if false;
    }

    /* Only the clinic's Google account may change anything.

       This is the REAL security boundary — the check in the admin panel's
       JavaScript is only there to show a friendly message, and anyone could
       bypass that. This one is enforced by Google's servers.

       To hand the site to a different account later, change the address here
       and press Publish. */
    function isAdmin(){
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'vijayshreehealthcare@gmail.com';
    }
  }
}
